/*********************************************************************
*	Classes for read to or write from standard or gzipped file
*********************************************************************/

struct ReadFile {
	FILE*	fd = 0;
	gzFile	gzfd = 0;
	int	dtype = 0;
	int	open(const char* fname, const char* extnt = datgz);
	void	close() {
	    if (fd && fd != stdin) {fclose(fd); fd = 0;}
	    if (gzfd) {fclose(gzfd); gzfd = 0;}
	}
	ReadFile() {}
	ReadFile(const char* fname, const char* extnt = datgz) {
	    if (fname) dtype = open(fname, extnt);
	}
	~ReadFile() {close();}
};

struct WriteFile {
	FILE*	fd = 0;
	gzFile	gzfd = 0;
	void	open(const char* fname, const int& text = 0, 
		const bool& gzip = true, const char* in_name = 0);
	void	close() {
	    if (fd && fd != stdout) {fclose(fd); fd = 0;}
	    if (gzfd) {fclose(gzfd); gzfd = 0;}
	}
	WriteFile() {}
	WriteFile(const char* fname, const int& text = 0, 
		const bool& gzip = true, const char* in_name = 0) {
	    if (fname) open(fname, text, gzip, in_name);
	    else	fd = stdout;
	}
	~WriteFile() {close();}
};

/*********************************************************************
*	Ftable class
*********************************************************************/

class Ftable {
	const	char* tabpath[3];
	char*	subdir;
	Gnm2tab*	g2t;
public:
	Ftable(const bool& cur_dir = true) : subdir(0), g2t(0) {
	    tabpath[0] = cur_dir? ".": 0;
	    tabpath[1] = getenv(ALN_TAB);
	    tabpath[2] = DEF_TAB_PATH;
	}
	~Ftable() {delete[] subdir; delete g2t;}
	void	setSubDir(const char* dir) {
	    if (!subdir || strcmp(subdir, dir))
		subdir = strrealloc(subdir, dir);
	}
	void	setpath(const char* ps, const char* convtab = 0);
	char*	getpath(char* fullpath, const char* fname);
	DIR*	dopen(const char* dname, const bool& test);
	FILE*	fopen(const char* fname, const char* mode);
	FILE*	fopen(const char* fname, const char* envpath, const char* defpath);
	int	ropen(ReadFile& fp, const char* fname, const char* extnt);
	Gnm2tab*	read_gnm2tab(int field = 5) {
	    if (!g2t) g2t = new Gnm2tab(field);
	    return (g2t);
	}
	gzFile	gzopen(const char* fname, const char* mode);
	gzFile	gzopen(const char* fname, const char* envpath, const char* defpath);
};

