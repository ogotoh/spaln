/*********************************************************************
*	utilities
*********************************************************************/

inline	long	file_size(const char* fn) {
	struct	stat buf;
	return (stat(fn, &buf) == -1? -1L: buf.st_size);
}

inline	time_t	access_time(const char* fn) {
	struct	stat buf;
	return (stat(fn, &buf) == -1? 0: buf.st_atime);
}

inline	time_t	modify_time(const char* fn) {
	struct	stat buf;
	return (stat(fn, &buf) == -1? 0: buf.st_mtime);
}

inline	time_t	change_time(const char* fn) {
	struct	stat buf;
	return (stat(fn, &buf) == -1? 0: buf.st_ctime);
}

inline	bool	is_file(const char* fn) {
	struct	stat buf;
	if (stat(fn, &buf) == -1) return (false);
	return (S_ISREG(buf.st_mode));
}

inline	bool	is_filled_file(const char* fn) {
	struct	stat buf;
	if (stat(fn, &buf) == -1) return (false);
	return (buf.st_size > 0L);
}

inline	bool	is_dir(const char* fn) {
	struct	stat buf;
	if (stat(fn, &buf) == -1) return (false);
	return (S_ISDIR(buf.st_mode));
}

inline	FILE* outfd(const char* fn)
{
	if (!fn || !(out_fd = wfopen(fn, "w"))) out_fd = stdout;
	return (out_fd);
}

/*********************************************************************
*	zlib utilities
*********************************************************************/

extern	size_t	lgzread(gzFile gzfd, char* buf, size_t sz);
extern	size_t	lgzwrite(gzFile gzfd, const char* buf, size_t sz);

inline	size_t  fread(void* buf, const size_t& s, const size_t& c, gzFile gzfd) {
	size_t	sz = s * c;
	size_t	rv = (sz > size_t(INT_MAX))?
	    lgzread(gzfd, (char*) buf, sz):
	    gzread(gzfd, buf, sz);
	return (rv <= 0? rv: rv / s);
}

inline	size_t	fwrite(const void* buf, const size_t& s, const size_t& c, gzFile gzfd) {
	size_t	sz = s * c;
	size_t	rv = (sz > size_t(INT_MAX))?
	    lgzwrite(gzfd, (const char*) buf, sz):
	    gzwrite(gzfd, buf, sz);
	return (rv <= 0? rv: rv / s);
}

inline	int fputs(const char* buf, gzFile gzfd) {
	return (gzputs(gzfd, buf));
}

inline	char* fgets(char* buf, const int& len, gzFile gzfd) {
	return (gzgets(gzfd, buf, len));
}

inline	int fputc(const int& c, gzFile gzfd) {
	return (gzputc(gzfd, c));
}

inline	int fgetc(gzFile gzfd) {
	return (gzgetc(gzfd));
}

inline	int ungetc(const int& c, gzFile gzfd) {
	return (gzungetc(c, gzfd));
}

inline	int rewind(gzFile gzfd) {
	return (gzrewind(gzfd));
}

inline	int fseek(gzFile gzfd, const long& offset, const int& whence) {
	return (gzseek(gzfd, offset, whence));
}

inline	long ftell(gzFile gzfd) {
	return (gztell(gzfd));
}
inline	int feof(gzFile gzfd) {
	return (gzeof(gzfd));
}
inline	int fclose(gzFile gzfd) {
	return (gzclose(gzfd));
}

inline	int fflush(gzFile gzfd) {
	return (gzflush(gzfd, Z_SYNC_FLUSH));
}

// Is xxx.gz file?

template <typename char_t>
inline char_t* is_gz(char_t* fn)
{
	char_t*	dot = (char_t*) strrchr(fn, '.');
	return ((dot && !strcmp(dot, gz_ext))? dot: 0);
}

// read through until new line

template <typename file_t>
int	flush_line(file_t fd)
{
	int	c;
	while ((c = fgetc(fd)) != EOF && c != '\n') ;
	return (c);
}

template <typename file_t>
char* fgetw(char* buf, const INT& maxl, file_t fd, const char* delm = stddelim)
{
	int	c;
	char*	qs = buf;
	char*	ts = buf + maxl - 1;
	while ((c = fgetc(fd)) != EOF && strchr(stddelim, c)) ;
	do {
	    *qs++ = c;
	    c = fgetc(fd);
	} while (c != EOF && !strchr(stddelim, c) && qs < ts);
	*qs = '\0';
	return (buf);
}

